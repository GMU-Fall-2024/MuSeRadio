main
{
    display: flex;
    flex-direction: column;
    width: 95%;
    height: 100vh;
    justify-content: center;
    align-items: center;
    gap: 0px;
    padding-left: 20px;
    /* background-color: red; */
}
div[id = "profile_form"]
{
    display: flex;
    flex-direction: column;
    width: 40%;
    height: 80%;
    /* outline: solid 1px rgb(0, 0, 0); */
    justify-content: center;
    align-items: center;
    gap: 10px;
    /* background */
    background-color: rgb(249, 251, 252);
    filter: drop-shadow(0px 0px 2px rgba(0, 0, 0, 0.25));
    border-radius: 15px;
}

section[id = "profile_photo"]
{
    display: flex;
    flex-direction: column;
    width: 20%;
    aspect-ratio: 1/1;
    /* outline: solid 1px rgb(0, 0, 0); */
    justify-content: center;
    align-items: center;
    gap: 10px;
    /* background */
    background-color: rgb(249, 251, 252);
    filter: drop-shadow(0px 0px 2px rgba(0, 0, 0, 0.25));
    border-radius: 20%;
    overflow: hidden;
}

section[id = "profile_photo"] img
{
    width: 100%;
    height: 100%;
    object-fit: contain;
}

section[id = "header"]
{
    display: flex;
    flex-direction: column;
    gap: 8px;
}

section[id = "header"] .title{
    display: flex;
    width: 100%;
    height: 10%;
    /* outline: solid 1px rgb(0, 0, 0); */
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-top: 10px;
    font-size: 1.8rem;
    font-weight: 700;
    color: black;
    font-family: 'Quicksand', sans-serif;
    text-transform: capitalize;
}

section[id = "header"] .caption{
    display: flex;
    width: 100%;
    height: 10%;
    /* outline: solid 1px rgb(0, 0, 0); */
    justify-content: center;
    align-items: center;
    gap: 20%;
    margin-top: 10px;
    font-size: 0.8rem;
    font-weight: 500;
    color: black;
    font-family: 'Quicksand', sans-serif;
    text-transform: capitalize;
}

section[id = "form"]
{
    display: flex;
    width: 100%;
    padding-left: 1%;
}

form[id = "profile_form_entry"] 
{
    display: flex;
    flex-direction: column;
    width: 95%;
    /* background-color: royalblue; */
}

form[id = "profile_form_entry"] fieldset 
{
    display: flex;
    width: 100%;
    justify-content: space-between;
}

form[id = "profile_form_entry"] fieldset .input_group
{
    display: flex;
    width: 100%;
    justify-content: space-between;
}

form[id = "profile_form_entry"] fieldset .input_group span
{
    display: flex;
    flex-direction: column-reverse;
}

textarea
{
    resize: none;
    text-align: left;
}