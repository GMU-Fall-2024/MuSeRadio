<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- base css -->
    <link rel="stylesheet" href="/css/navigation.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/footer.css">
    <!-- page specific css -->
    <% for (var i = 0; i < stylesheets.length; i++) { %>
        <link rel="stylesheet" href="<%= stylesheets[i] %>">
    <% } %>

    <!-- base javascript -->
    <script src="https://kit.fontawesome.com/8c9fcb09a3.js" crossorigin="anonymous"></script>

    <!-- base modules -->

    <!-- page specific javascript -->
    <% for (var i = 0; i < scripts.length; i++) { %>
        <script src="<%= scripts[i] %>"></script>
    <% } %>

    <!-- page specific modules -->
    <% for (var i = 0; i < modules.length; i++) { %>
        <script type="module" src="<%= modules[i] %>"></script>
    <% } %>

    <!-- page title -->
    <title><%= page_title %></title>
</head>
<body>
    <header> 
        <span>
           <button id = "system_settings">
              <i class="fa-solid fa-gears"></i>
           </button>
           <label for="system_settings">settings</label>
        </span>
        <span>
           <button id = "system_help" onclick="window.location.href = '/help';">
              <i class="fa-solid fa-person-circle-question"></i>
           </button>
           <label for="system_help">help</label>
        </span>
     </header>
     <nav>
        <!-- company logo -->
        <span class="nav_group" id = "brand">
           <button onclick="window.location.href = '/';">
              <img src="/assets/brand/SVG/MuSe.svg" alt="">
              <span class="logo_text">MuSe<sup>®</sup></span>
           </button>
        </span>
        <hr class = "nav_separator">
        <span class="nav_group" id = "primary_group">
           <ul class="group_list">
              <li class="group_item">
                 <button id = "home" onclick="window.location.href = '/';">
                    <i class="fa-solid fa-house"></i>
                 </button>
              </li>
              <label for="home">home</label>
              <li class="group_item">
                 <button id = "schedule" onclick="window.location.href = '/schedule/<%= dj.id %>';">
                    <i class="fa-solid fa-calendar-week"></i>
                 </button>
              </li>
              <label for="schedule">schedule</label>
              <li class="group_item">
                 <button id = "live" onclick="window.location.href = '/broadcast/<%= dj.next_event.eventid %>';">
                    <i class="fa-solid fa-tower-broadcast"></i>
                 </button>
              </li>
              <label for="live">live</label>
              <li class="group_item">
                 <button id = "messaging" onclick="window.location.href = './MuSe_DJ_Messaging.html';">
                    <i class="fa-solid fa-envelope-open-text"></i>
                 </button>
              </li>
              <label for="messaging">messaging</label>
              <li class="group_item">
                 <button id = "metrics" onclick="window.location.href = './MuSe_DJ_Metrics.html';">
                    <i class="fa-solid fa-chart-simple"></i>
                 </button>
              </li>
              <label for="metrics">metrics</label>
           </ul>
        </span>
        <hr class = "nav_separator">
        <span class="nav_group" id = "secondary_group">
           <ul class="group_list">
              <li class="group_item">
                 <button id = "profile" onclick = "window.location.href = '/profile/<%= dj.userid %>';">
                    <i class="fa-solid fa-user"></i>
                 </button>
              </li>
              <label for="profile">profile</label>
              <li class="group_item">
                 <button id = "exit" onclick="window.close();"> 
                    <i class="fa-solid fa-right-from-bracket"></i>
                 </button>
              </li>
              <label for="exit">exit</label>
           </ul>
        </span>
     </nav>
    <%- body %>
    <footer>
        We are MuSe&reg; Radio
    </footer>
</body>
</html>